# Vercel Postgres (any of POSTGRES_URL or DATABASE_URL works)
POSTGRES_URL="postgresql://user:pass@host:5432/db"

# Vercel Blob (set automatically when you add the Blob store in Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Private Blob store (connected with env prefix BLOB_PRIVATE_). Files here are
# only reachable through /p/<slug>/, behind the password gate.
BLOB_PRIVATE_READ_WRITE_TOKEN="vercel_blob_rw_..."
# "private" sends new uploads to the private store; unset = public store.
BLOB_WRITE_TARGET="private"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Optional: set to allow seeding the first admin user on first run
# If unset, no seed runs. Set both to bootstrap.
SEED_ADMIN_EMAIL="brett@thebault.co.uk"
SEED_ADMIN_PASSWORD="change-me"

# Optional: override the content origin (where /p/<slug>/ links point).
# Defaults to https://content.thebnut.com in production. Preview/dev
# fall back to single-origin if this is unset.
# NEXT_PUBLIC_CONTENT_URL="https://content.thebnut.com"
